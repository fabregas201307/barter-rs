# Stage 1: Build the backtest binary
FROM rust:1.91 AS builder

WORKDIR /usr/src/app

# Install build dependencies required by barter-data/openssl-sys
RUN apt-get update && apt-get install -y \
    clang \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy the Rust project source code into the builder
COPY . .

# Pre-build the specific example
RUN cargo build --release --example bond_event_signals_backtest -p barter

# Stage 2: Jupyter runtime with the prebuilt binary
FROM rust:1.91

# Install Python 3 and dependencies for Jupyter
# We run `apt-get update` and install python3-venv for environment management
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Set up a Python virtual environment for Jupyter
# This isolates python packages and avoids conflicts with system python
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install JupyterLab
RUN pip install jupyterlab

# Set workspace directory
WORKDIR /workspace

# Copy the Rust project source code into the container (for notebooks/examples)
COPY . .

# Copy the prebuilt binary from the builder stage
COPY --from=builder /usr/src/app/target/release/examples/bond_event_signals_backtest /usr/local/bin/bond_event_signals_backtest

# Create a dedicated directory for data (mount point for PVC)
RUN mkdir -p /workspace/data

# Seed default data files into the image (can be overridden by a host mount)
COPY barter/examples/data/bond_marks_template.csv /workspace/data/
COPY barter/examples/data/bond_signals_template.csv /workspace/data/

# Expose the standard Jupyter port
EXPOSE 8888

# Set the ENTRYPOINT/CMD to start JupyterLab
# --allow-root is required because the official Rust image runs as root
# --no-browser prevents it from trying to open a browser in the container
# --NotebookApp.token='' disables authentication (useful for internal/demo use; configure auth for prod)
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--allow-root", "--no-browser", "--NotebookApp.token=''", "--NotebookApp.password=''"]
