# Use the official Rust image (bookworm variant has useful build tools)
FROM rust:1-bookworm

# Install Python 3 and dependencies for Jupyter
# We run `apt-get update` and install python3-venv for environment management
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    clang \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Set up a Python virtual environment for Jupyter
# This isolates python packages and avoids conflicts with system python
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install JupyterLab
RUN pip install jupyterlab

# Set workspace directory
WORKDIR /workspace

# Copy the Rust project source code into the container
COPY . .

# Pre-build the specific example
# This ensures dependencies are downloaded and compiled, making the "first run" fast for the user.
RUN cargo build --release --example bond_event_signals_backtest -p barter

# Create a dedicated directory for data (mount point for PVC)
RUN mkdir -p /workspace/data

# Expose the standard Jupyter port
EXPOSE 8888

# Set the ENTRYPOINT/CMD to start JupyterLab
# --allow-root is required because the official Rust image runs as root
# --no-browser prevents it from trying to open a browser in the container
# --NotebookApp.token='' disables authentication (useful for internal/demo use; configure auth for prod)
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--allow-root", "--no-browser", "--NotebookApp.token=''", "--NotebookApp.password=''"]
